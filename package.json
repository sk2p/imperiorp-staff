{
  "name": "imperiorp-staff-management",
  "version": "1.0.0",
  "description": "Sistema profesional de gestión interna de staff, horas y liquidaciones para Imperio RP",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap": "tsx src/db/seed.ts --only-bootstrap",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:provision": "tsx src/db/provision.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pdfkit": "~0.17.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "10.5.5",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
