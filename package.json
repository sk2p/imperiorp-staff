{
  "name": "imperiorp-staff-management",
  "version": "1.0.0",
  "description": "Sistema profesional de gestión interna de staff, horas y liquidaciones para Imperio RP",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:bootstrap": "tsx --env-file=.env src/db/seed.ts --only-bootstrap",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:provision": "tsx --env-file=.env src/db/provision.ts",
    "db:add-account": "tsx --env-file=.env src/db/add-account.ts",
    "db:set-role": "tsx --env-file=.env src/db/set-role.ts",
    "db:smoke": "tsx --env-file=.env src/db/smoke.ts",
    "db:backup": "tsx --env-file=.env src/db/backup.ts",
    "db:verificar-copia": "tsx --env-file=.env.prueba src/db/verify-backup.ts",
    "db:reparar-snapshots": "tsx --env-file=.env src/db/repair-snapshots.ts",
    "bot": "tsx --env-file=.env src/bot/index.ts",
    "bot:dev": "tsx watch --env-file=.env src/bot/index.ts",
    "bot:emojis": "tsx --env-file=.env src/bot/sync-emojis.ts",
    "bot:build": "node scripts/build-bot.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pdfkit": "~0.17.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "ws": "^8.21.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "10.5.5",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
