

NODE_ENV=production

# Zona horaria con la que se muestran fechas y horas.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# La MISMA base que usa la página. El bot y la web comparten todo:
# fichajes, horas, períodos y pagos.
DATABASE_URL=postgresql://usuario:clave@host:5432/imperiorp_staff?sslmode=require

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Bot de fichajes de Discord
# ─────────────────────────────────────────────────────────────────────────────
# Del portal de desarrolladores de Discord → tu aplicación → Bot → Reset Token.
DISCORD_TOKEN=
# Application ID, en la misma aplicación → General Information.
DISCORD_CLIENT_ID=
# Con esto los comandos aparecen al instante en ese servidor.
DISCORD_GUILD_ID=

# Canales donde se publica cada fichaje cerrado, uno por bloque de staff.
DISCORD_REGISTRO_HIGH=
DISCORD_REGISTRO_MID=
DISCORD_REGISTRO_LOW=

# Canales del resumen diario de medianoche, uno por bloque.
DISCORD_RESUMEN_HIGH=
DISCORD_RESUMEN_MID=
DISCORD_RESUMEN_LOW=

# Resumen con TODO el staff junto.
DISCORD_RESUMEN_GLOBAL=

# Canal donde la PÁGINA avisa cada pago registrado o anulado.
DISCORD_PAGOS=

# ─────────────────────────────────────────────────────────────────────────────
# Emojis personalizados
# ─────────────────────────────────────────────────────────────────────────────
# Vacío = usa el emoji común que ya trae el bot.
# Para personalizarlo: pnpm bot:emojis

# Botones del panel
EMOJI_ENTRADA=
EMOJI_SALIDA=
EMOJI_ACTIVOS=
EMOJI_HORAS=
EMOJI_ADMIN=
EMOJI_VINCULAR=

# Estados
EMOJI_EXITO=
EMOJI_ERROR=
EMOJI_DENEGADO=
EMOJI_INFO=

# Registros de fichaje
EMOJI_FICHAJE=
EMOJI_RELOJ=
EMOJI_CALENDARIO=
EMOJI_STAFF=

# Reportes diarios
EMOJI_REPORTE=
EMOJI_GLOBAL=

# Pagos
EMOJI_PAGO=
EMOJI_DINERO=
EMOJI_ANULADO=

# Categorías de staff
EMOJI_HIGH=
EMOJI_MID=
EMOJI_LOW=

# Marca
EMOJI_IMPERIO=

# Rachas, récords y alertas
EMOJI_RACHA=
EMOJI_RECORD=
EMOJI_ALERTA=

# Vigilancia de la página: el bot la mira cada 5 minutos y avisa por privado a
# los fundadores si se cae. Vacío = vigila https://imperiorp-staff.vercel.app.
# "no" = apagada.
URL_PAGINA=

# Bitácora en Discord (webhook).
DISCORD_LOG_WEBHOOK=

# Modo mantenimiento.
MODO_MANTENIMIENTO=false

# Canal PRIVADO donde el bot deja la copia de seguridad diaria.
DISCORD_BACKUP_WEBHOOK=
