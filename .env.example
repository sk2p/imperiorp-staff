# =============================================================================
# IMPERIO RP — Variables de entorno
# Copiá este archivo a .env y completá los valores. NUNCA subas el .env al repo.
# =============================================================================

NODE_ENV=production

# URL pública de la app. Se usa para validar el origen de las peticiones.
APP_URL=https://staff.tudominio.com

# Zona horaria con la que se muestran fechas y horas.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL estándar: sirve Railway, Supabase, Neon, Render, Docker o propio.
# En desarrollo podés dejarla VACÍA y la app usa PGlite embebido.
DATABASE_URL=postgresql://usuario:clave@host:5432/imperiorp_staff?sslmode=require

# Forzar TLS aunque el host parezca local (opcional).
# DATABASE_SSL=true

# Conexiones simultáneas del pool.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
# Mínimo 32 caracteres. Generalo con:  openssl rand -base64 48
#
# IMPORTANTE: de este secreto se deriva el "pepper" de las contraseñas.
# Si lo cambiás, NINGUNA contraseña existente va a funcionar y hay que
# restablecerlas todas. Guardalo bien y no lo rotes a la ligera.
SESSION_SECRET=

# Días que dura una sesión como máximo (además caduca a las 12 h sin actividad).
SESSION_TTL_DAYS=7

# Intentos fallidos antes de bloquear, y duración del bloqueo en minutos.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Primer usuario
# -----------------------------------------------------------------------------
# Se crea solo la primera vez que arranca, si la base está vacía.
INITIAL_ADMIN_USERNAME=owner
# Si la dejás vacía, se genera una al azar y se muestra UNA vez en los logs.
INITIAL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# Poné false si preferís aplicar las migraciones como paso aparte del deploy.
RUN_MIGRATIONS_ON_BOOT=true

# ─────────────────────────────────────────────────────────────────────────────
# Bot de fichajes de Discord
# ─────────────────────────────────────────────────────────────────────────────
# Del portal de desarrolladores de Discord → tu aplicación → Bot → Reset Token.
DISCORD_TOKEN=
# Application ID, en la misma aplicación → General Information.
DISCORD_CLIENT_ID=
# Con esto los comandos aparecen al instante en ese servidor. Sin esto tardan
# hasta una hora en propagarse. Para probar, ponelo.
DISCORD_GUILD_ID=

# Canales donde se publica cada fichaje cerrado, uno por bloque de staff.
DISCORD_REGISTRO_HIGH=
DISCORD_REGISTRO_MID=
DISCORD_REGISTRO_LOW=

# Canales del resumen diario de medianoche, uno por bloque.
DISCORD_RESUMEN_HIGH=
DISCORD_RESUMEN_MID=
DISCORD_RESUMEN_LOW=

# Resumen con TODO el staff junto.
DISCORD_RESUMEN_GLOBAL=

# Canal donde la PÁGINA avisa cada pago registrado o anulado.
# Para que esto funcione, DISCORD_TOKEN también tiene que estar en Vercel.
DISCORD_PAGOS=

# ─────────────────────────────────────────────────────────────────────────────
# Emojis personalizados
# ─────────────────────────────────────────────────────────────────────────────
# Vacío = usa el emoji común que ya trae el bot.
#
# LA FORMA FÁCIL: subí los emojis a la APLICACIÓN (portal de desarrolladores →
# tu aplicación → Emojis) con el mismo nombre que la variable, y corré
# `pnpm bot:emojis`. Se los pregunta a Discord y completa todo esto solo.
#
# A mano también se puede: pegá el código completo, con los signos < >:
#
#     EMOJI_ENTRADA=<:imp_entrada:1234567890123456789>
#
# Para copiarlo: escribí :nombre: en cualquier canal y mandalo. Discord te
# muestra el emoji; poniendo una barra invertida adelante te muestra el código.
# Si el emoji es animado, el código arranca con <a: en vez de <: — pegalo igual.

# Botones del panel
EMOJI_ENTRADA=
EMOJI_SALIDA=
EMOJI_ACTIVOS=
EMOJI_HORAS=
EMOJI_ADMIN=
EMOJI_VINCULAR=

# Estados
EMOJI_EXITO=
EMOJI_ERROR=
EMOJI_DENEGADO=
EMOJI_INFO=

# Registros de fichaje
EMOJI_FICHAJE=
EMOJI_RELOJ=
EMOJI_CALENDARIO=
EMOJI_STAFF=

# Reportes diarios
EMOJI_REPORTE=
EMOJI_GLOBAL=

# Pagos
EMOJI_PAGO=
EMOJI_DINERO=
EMOJI_ANULADO=

# Categorías de staff
EMOJI_HIGH=
EMOJI_MID=
EMOJI_LOW=

# Marca
EMOJI_IMPERIO=

# Bitácora en Discord: cada movimiento del panel y cada evento de seguridad,
# mandados a un canal por webhook. Sin esto el sistema anda igual, sólo que
# los registros viven únicamente en la auditoría de la página.
DISCORD_LOG_WEBHOOK=

# Modo mantenimiento: con "true" toda la página muestra la pantalla de
# mantenimiento. Los chequeos de salud siguen respondiendo.
MODO_MANTENIMIENTO=false
